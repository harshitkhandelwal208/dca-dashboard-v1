# Settings of the production bot. Copy to a private file (never commit it) and pass it to provision.sh.
# __DOMAIN__ is replaced by the instance's address (e.g. 1-2-3-4.sslip.io).
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
COMMUNITY_GUILD_ID=
RECRUITMENT_GUILD_ID=
RECRUITER_ROLE_ID=
DASHBOARD_ALLOWED_ROLE_ID=
DASHBOARD_BASE_URL=https://__DOMAIN__
DASHBOARD_PUBLIC_URL=https://__DOMAIN__
DISCORD_REDIRECT_URI=https://__DOMAIN__/auth/discord/callback
DASHBOARD_SESSION_SECRET=
FIREBASE_DATABASE_TYPE=realtime
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_STATE_ROOT=dca_bot_state
